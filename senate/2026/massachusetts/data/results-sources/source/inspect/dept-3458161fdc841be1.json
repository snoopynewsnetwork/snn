    "\n        /* Third-party accessibility/gallery widget a11y patches. These run only when\n           the widget is present and only ADD attributes (labels / aria-hidden on\n           decorative icons / landmark wrappers) -- we never hide or remove a working\n           widget, so sites that use UserWay/accessiBe/Lightbox are unaffected. */\n        (function () {\n            var UW_SELECTOR = '[class*=\"userway\"],[class*=\"uwaw\"],[id*=\"userway\"]';\n            function accessibleName(el) {\n                return el.getAttribute('aria-label') ||\n                    el.getAttribute('aria-labelledby') ||\n                    el.getAttribute('title') ||\n                    (el.textContent && el.textContent.trim());\n            }\n            function labelUserwayTriggers() {\n                var buttons = document.querySelectorAll('[role=\"button\"]');\n                for (var i = 0; i < buttons.length; i++) {\n                    var el = buttons[i];\n                    if (!el.closest(UW_SELECTOR)) continue;\n                    if (!accessibleName(el)) el.setAttribute('aria-label', 'Accessibility menu');\n                }\n                /* The launcher's inner SVG icons are decorative once the button is\n                   named; hide them so they don't trip svg-has-no-accessible-name. */\n                var svgs = document.querySelectorAll(UW_SELECTOR + ' svg');\n                for (var j = 0; j < svgs.length; j++) {\n                    var svg = svgs[j];\n                    if (accessibleName(svg) || svg.querySelector('title')) continue;\n                    svg.setAttribute('aria-hidden', 'true');\n                    svg.setAttribute('focusable', 'false');\n                }\n                /* UserWay marks its launcher wrapper aria-hidden=\"true\" yet leaves the\n                   launcher button tabbable (aria_hidden_nontabbable). The button is a\n                   real control, so un-hide the wrapper rather than remove keyboard\n                   access. Only touch wrappers that actually hold a focusable element. */\n                var hiddenWraps = document.querySelectorAll(UW_SELECTOR + '[aria-hidden=\"true\"]');\n                for (var w = 0; w < hiddenWraps.length; w++) {\n                    if (hiddenWraps[w].querySelector('a[href],button,input,select,textarea,[tabindex],[role=\"button\"]')) {\n                        hiddenWraps[w].removeAttribute('aria-hidden');\n                    }\n                }\n            }\n            /* accessiBe (paid ADA add-on some clients load) renders its launcher inside\n               open shadow roots on <access-widget-ui> hosts, with icon SVGs that have no\n               accessible name and occasionally an unnamed button. We keep the widget\n               working and just name/hide those so they stop failing the scanner. */\n            function patchAccessibe() {\n                /* accessiBe also drops a light-DOM trigger <div role=\"button\"> with no\n                   text/label (\"button role has no associated label\"); name it. */\n                var triggers = document.querySelectorAll('.acsb-trigger,[class*=\"acsb\"][role=\"button\"]');\n                for (var t = 0; t < triggers.length; t++) {\n                    if (!accessibleName(triggers[t])) triggers[t].setAttribute('aria-label', 'Accessibility options');\n                }\n                var hosts = document.querySelectorAll('access-widget-ui');\n                for (var i = 0; i < hosts.length; i++) {\n                    var root = hosts[i].shadowRoot;\n                    if (!root) continue;\n                    var svgs = root.querySelectorAll('svg');\n                    for (var s = 0; s < svgs.length; s++) {\n                        if (accessibleName(svgs[s]) || svgs[s].querySelector('title')) continue;\n                        svgs[s].setAttribute('aria-hidden', 'true');\n                        svgs[s].setAttribute('focusable', 'false');\n                    }\n                    var btns = root.querySelectorAll('button,[role=\"button\"]');\n                    for (var b = 0; b < btns.length; b++) {\n                        if (!accessibleName(btns[b])) btns[b].setAttribute('aria-label', 'Accessibility options');\n                    }\n                    /* The host sits directly under <body>, so its content is \"not within\n                       a landmark\". Make each visible, non-empty host a region landmark,\n                       labelled from its button when present else an index (kept unique\n                       to avoid the duplicate-landmark-label rule). */\n                    var host = hosts[i];\n                    if (!host.getAttribute('role') && root.childElementCount > 0 && getComputedStyle(host).display !== 'none') {\n                        var namer = root.querySelector('button,[role=\"button\"]');\n                        host.setAttribute('role', 'region');\n                        host.setAttribute('aria-label', ((namer && accessibleName(namer)) || ('Accessibility widget ' + (i + 1))).slice(0, 60));\n                    }\n                }\n                /* accessiBe's screen-reader-only <a>/<span> helpers are also loose under\n                   <body>; gather them under one region landmark. */\n                var loose = document.querySelectorAll('body > a.acsb-sr-only, body > span.acsb-sr-alert, body > .acsb-sr-only');\n                if (loose.length) {\n                    var region = document.getElementById('acsb-sr-landmark');\n                    if (!region) {\n                        region = document.createElement('div');\n                        region.id = 'acsb-sr-landmark';\n                        region.setAttribute('role', 'region');\n                        region.setAttribute('aria-label', 'Accessibility screen reader helpers');\n                        loose[0].parentNode.insertBefore(region, loose[0]);\n                    }\n                    for (var l = 0; l < loose.length; l++) {\n                        if (loose[l].parentNode !== region) region.appendChild(loose[l]);\n                    }\n                }\n            }\n            /* Lightbox2 (image gallery lib) injects close/cancel controls as\n               <a role=\"button\"> with no text -> \"button role has no associated label\". */\n            function patchLightbox() {\n                var map = [\n                    ['.lb-close', 'Close image'],\n                    ['.lb-cancel', 'Close image'],\n                    ['.lb-prev', 'Previous image'],\n                    ['.lb-next', 'Next image']\n                ];\n                for (var i = 0; i < map.length; i++) {\n                    var els = document.querySelectorAll(map[i][0]);\n                    for (var j = 0; j < els.length; j++) {\n                        if (!accessibleName(els[j])) els[j].setAttribute('aria-label', map[i][1]);\n                    }\n                }\n            }\n            function processOverlays() {\n                labelUserwayTriggers();\n                patchAccessibe();\n                patchLightbox();\n            }\n            function init() {\n                processOverlays();\n                var obs = new MutationObserver(processOverlays);\n                obs.observe(document.body, { childList: true, subtree: true });\n                /* Overlays load async and accessiBe fills an encapsulated shadow root\n                   the observer can't see, so poll for ~30s as well. */\n                var ticks = 0;\n                var poll = setInterval(function () {\n                    processOverlays();\n                    if (++ticks >= 15) { clearInterval(poll); obs.disconnect(); }\n                }, 2000);\n            }\n            if (document.readyState === 'loading') {\n                document.addEventListener('DOMContentLoaded', init);\n            } else {\n                init();\n            }\n        })();\n    "
