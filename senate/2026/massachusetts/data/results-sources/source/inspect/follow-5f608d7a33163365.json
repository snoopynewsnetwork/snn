    "\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n  const exitModal = document.getElementById('exitModal');\r\n  const confirmExitBtn = document.getElementById('confirmExitBtn');\r\n  const cancelExitBtn = document.getElementById('cancelExitBtn');\r\n  let targetUrl = ''; // To store the URL of the external link\r\n\r\n  // List of specific external sites to trigger the modal for\r\n  const specificExternalSites = [\r\n    'unipaygold.unibank.com',\r\n    'cityofpeabodyma.municipalonlinepayments.com',\r\n\t  'main.govpilot.com',\r\n\t  'peabodyma.mapgeo.io',\r\n\t  'peabodyma.portal.opengov.com',\r\n\t  'www.surveymonkey.com'\r\n  ];\r\n\r\n  document.body.addEventListener('click', function(event) {\r\n    let link = event.target.closest('a'); // Find the closest ancestor that is an <a> tag\r\n\r\n    if (link && link.href) {\r\n      const currentDomain = window.location.hostname;\r\n      const targetDomain = new URL(link.href).hostname;\r\n\r\n      // Check if it's an external link AND if its domain is in our specific list\r\n      if (targetDomain !== currentDomain && specificExternalSites.includes(targetDomain)) {\r\n        event.preventDefault(); // Prevent default navigation\r\n        targetUrl = link.href; // Store the target URL\r\n        exitModal.style.display = 'block'; // Show the modal\r\n      }\r\n    }\r\n  });\r\n\r\n  confirmExitBtn.addEventListener('click', function() {\r\n    exitModal.style.display = 'none'; // Hide the modal\r\n    window.open(targetUrl, '_blank'); // Navigate to the external site\r\n  });\r\n\r\n  cancelExitBtn.addEventListener('click', function() {\r\n    exitModal.style.display = 'none'; // Hide the modal\r\n    targetUrl = ''; // Clear the stored URL\r\n  });\r\n});\r\n",
