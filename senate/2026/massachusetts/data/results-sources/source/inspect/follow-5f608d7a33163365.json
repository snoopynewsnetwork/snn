  "forms": [
    "<form action=\"results.html\">\n<div class=\"input-group tipue_search_group\">\n<label class=\"visually-hidden\" for=\"tipue_search_input\">Search</label>\n<input aria-describedby=\"searchInstructions\" id=\"tipue_search_input\" name=\"q\" pattern=\".{3,}\" placeholder=\" How can we help you? \" required=\"\" title=\"At least 3 characters\" type=\"text\"/>\n<span class=\"visually-hidden\" id=\"searchInstructions\">Please enter at least 3 characters.</span>\n<button aria-label=\"Go button for search\" class=\"input-group-tet tipue_search_button bg-success text-center\" type=\"submit\">GO</button>\n</div>\n</form>"
  ],
  "inline_scripts": [
    "document.write(new Date().getFullYear());",
    "\r\n\r\nvar isReady=0;function makeReady(){isReady=1;}function goSearch(sTextPos){if(document.Search.elements[sTextPos].value==\"\"){document.Search.elements[sTextPos].value=\"index\";}}function writeDaMail(mailStart,mailEnd,mailToText,mailLink,tabIndex){document.write('<A HREF=\"'+mailToText+mailStart+mailEnd+'\" TABINDEX=\"'+tabIndex+'\" TITLE=\"Email '+mailLink+'\">'+mailLink+'<\\/A>');}\r\n\r\n",
    "\r\nfunction emailAddr(a) {\r\nRE = /^(.+)\\#(.+)$/;\r\nvar launch = a.replace(RE,\"mailto:$1@$2\");\r\nwindow.location = launch;\r\n}\r\n",
    "\r\n$(document).ready(function() {\r\n     $('#tipue_search_input').tipuesearch();\r\n\t \r\n});\r\n",
    "\r\n$(document).ready(function() {\r\n  setTimeout(function() {\r\n    $('.alert').addClass('active');\r\n  }, 1000);\r\n\r\n  $('.alert-banner-close').click(function() {\r\n    $(this).parent().remove();\r\n\tjQuery(this).parent().height(0);\r\n\t\r\n  });\r\n});\r\n",
    "\r\n$(window).on('load',function(){\r\n\tsetTimeout(function(){ // allowing 3 secs to fade out loader\r\n\t$('#page-loading').fadeOut(100);\r\n\t},100);\r\n});\r\n   ",
    "\r\n\r\n$(document).ready(function(){\r\n  \r\n  $(\".dropdown\").click(function(){\r\n    $(\".menu\").toggleClass(\"showMenu\");\r\n      $(\".menu > li > a\").click(function(){\r\n        $(\".dropdown > p\").html($(this).html());\r\n          $(\".menu\").removeClass(\"showMenu\");\r\n      });\r\n  });\r\n  \r\n});\r\n",
