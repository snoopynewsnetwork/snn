                 \r\n         \r\n\r\n             \r\n\r\n                         Tuesday September 1, 2026 \r\n 2026 State Primary Election \r\n\r\n\r\n             \r\n\r\n                 \r\n                             \r\n                                 \r\n                                 OFFICIAL STATE PRIMARY RESULTS HAVERHILL SEPT 2026\r\n                             \r\n                 \r\n\r\n         \r\n         \r\n\r\n\r\n\r\n                     \r\n         \r\n     \r\n       \r\n\r\n         \r\n                     \r\n\r\n\r\n                     \r\n         \r\n\r\n             \r\n\r\n                         Sign Up \r\n Election Reminders \r\n\r\n\r\n             \r\n\r\n                 \r\n                             \r\n                                 \r\n                                 SIGN UP\r\n                             \r\n                 \r\n\r\n         \r\n         \r\n\r\n\r\n\r\n                     \r\n         \r\n     \r\n       \r\n\r\n         \r\n                     \r\n\r\n         \r\n         \r\n             \r\n\r\n                 Helpful Information \r\n\r\n             \r\n         \r\n         \r\n\r\n\r\n                     \r\n\r\n                             \r\n                             \r\n                                 \r\n\r\nRegister to Vote \r\n                                 \r\n                             \r\n                             \r\n                             \r\n                             \r\n                                 \r\n\r\nRegister to Vote Online \r\n                                 \r\n                             \r\n                             \r\n                             \r\n                             \r\n                                 \r\n\r\nWhere Do I Vote? \r\n                                 \r\n                             \r\n                             \r\n                             \r\n                             \r\n                