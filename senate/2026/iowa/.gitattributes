# Public evidence and extracted layout text retain exact bytes and spacing.
data/turnout/raw/** -text -whitespace
data/turnout/text/** -text -whitespace
data/results-sources/originals/** -text -whitespace
data/results-sources/extracts/*.txt -text -whitespace
