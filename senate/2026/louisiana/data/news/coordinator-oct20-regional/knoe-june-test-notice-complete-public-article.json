  "content_elements": [
    {
      "_id": "FRHZR3A4T5FGRL6T4KG7A667UQ",
      "additional_properties": {},
      "content": "MONROE, La. (KNOE) - KNOE is testing its election results system Wednesday, June 24 in preparation for the June 27 2nd party primary and municipal primary election. ",
      "type": "text"
    },
    {
      "_id": "BC7RTTELYREN3FKYUGGUFFJFUM",
      "additional_properties": {},
      "content": "During the test period, KNOE’s website will display mock results. These mock election results are only for testing purposes, and do not reflect any actual results.",
      "type": "text"
    },
    {
      "_id": "4C2YQKM3F5FO5I727W4WZYFH5M",
      "additional_properties": {},
      "content": "KNOE thanks our viewers and audience for understanding that we need to test our election systems in part of preparing for elections. ",
      "type": "text"
    }
  ],
