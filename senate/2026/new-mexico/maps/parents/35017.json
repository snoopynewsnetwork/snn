          "text": "Notice Of Election - 2026 Primary",
          "href": "/DocumentCenter/View/2468",
          "url": "https://grantcountynm.gov/DocumentCenter/View/2468",
          "attrs": {
            "href": "/DocumentCenter/View/2468",
