  "body_text": "\n \n   \n     \n     \n     Map Viewer \n     \n      :root {\n        --loader-color: #0079c1;\n        --loader-bg: #f8f8f8;\n      }\n\n      html,\n      body {\n        margin: 0;\n        padding: 0;\n        height: 100%;\n        width: 100%;\n        overflow: hidden;\n      }\n\n      .map-loader {\n        position: fixed;\n        top: 0;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        background: var(--loader-bg);\n        z-index: 9999;\n        transition: opacity 0.1s ease-out;\n      }\n\n      .map-loader-spinner {\n        width: 64px;\n        height: 64px;\n        border: 4px solid rgba(0, 121, 193, 0.2);\n        border-top-color: var(--loader-color);\n        border-radius: 50%;\n        animation: spin 1s linear infinite;\n      }\n\n      @keyframes spin {\n        to {\n          transform: rotate(360deg);\n        }\n      }\n\n      .map-loader.hidden {\n        opacity: 0;\n        pointer-events: none;\n      }\n\n      .calcite-shell-container {\n        position: absolute;\n        top: 0;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        opacity: 0;\n        transition: opacity 0.1s ease-in;\n      }\n\n      .calcite-shell-container.ready {\n        opacity: 1;\n      }\n     \n     \n      var esriDeprecation = \"false\" === \"true\";\n      window.esriConfig = {\n        has: {\n          \"esri-deprecation-warnings\": esriDeprecation,\n        },\n      };\n     \n     \n     \n     \n     \n     \n     \n   \n   \n     \n       \n     \n     \n   \n \n"
